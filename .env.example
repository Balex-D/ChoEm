NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql://choem:choem_dev_only@localhost:5432/choem
# Only set this when the app is behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Used by docker compose PostgreSQL. Use a long random password on a server.
POSTGRES_PASSWORD=choem_dev_only
# Only used by compose.production.yaml. Set a domain pointed to your server IP.
APP_DOMAIN=choem.example.com
