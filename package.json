{
  "name": "cho-em",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx server/src/index.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node --env-file=.env server/build/index.js",
    "start:container": "node server/build/index.js",
    "db:migrate": "node --env-file=.env --import tsx server/src/db/migrate.ts",
    "test": "node --import tsx --test server/test/*.test.ts",
    "check": "tsc -p server/tsconfig.json --noEmit",
    "password:reset": "node --env-file=.env --import tsx server/src/modules/auth/reset-password.ts",
    "format": "prettier --write \"dist/**/*.js\" \"server/**/*.ts\" \"server/**/*.json\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "light-my-request": "^6.8.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
